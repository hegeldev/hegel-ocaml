open Generators_core
open Generators_primitives

#ifdef OXCAML
#define MODE(m) @ m
#define ABSTRACT(a, k) (type (a : k))
#define KIND(k) : k
#define FINALISE Gc.Safe.finalise
#else
#define MODE(m)
#define ABSTRACT(a, k) (type a)
#define KIND(k)
#define FINALISE Gc.finalise
#endif

(** [sampled_from options] creates a generator that samples from a non-empty
    list of values.

    Implemented as an integer index generator: picks an index in [0, n-1] and
    returns [options.(index)]. The engine's bounded-integer draw is deliberately
    non-uniform (boundary and "interesting" indices are over-weighted), so
    earlier elements — the first in particular — are drawn more often than the
    middle ones. The output type is the caller's, so the result carries no
    printer; use {!with_printer} to draw it with {!draw}.

    We use a list instead of an array because arrays are contended inside a
    portable closure, but Array.* operations need uncontended arrays. *)
let%template sampled_from ABSTRACT(a, value mod c) (options : a list MODE(m))
  : (a, unprintable) generator MODE(m)
  =
  let n = List.length options in
  if n = 0 then raise (Internal.Usage_error "sampled_from requires at least one element");
  (map [@mode m]) (fun i -> List.nth options i) (integers ~min_value:0 ~max_value:(n - 1) ())
[@@mode (m, c) = ((nonportable, uncontended), (portable, contended))]
;;

(** [one_of generators] creates a generator that picks from one of the given
    [generators], all of which must be printable. Requires at least one
    generator.

    An index is drawn inside a {!Labels.one_of} span and that branch is
    generated compositionally. Each draw records the chosen branch's printer, so
    the drawn value renders through the printer of the branch it actually came
    from; before any draw, the printer defaults to the first branch's. The
    record is per generator value: if one [one_of] generator is drawn several
    times before printing (e.g. as the element generator of [lists]), every
    value renders through the most recently drawn branch's printer. *)
let%template one_of (generators : ('a, printable) generator list MODE(m))
  : ('a, printable) generator MODE(m)
  =
  match generators with
  | [] -> failwith "one_of requires at least one generator"
  | _ :: _ ->
    let n = List.length generators in
    (* the branch the last draw came from; 0 (the first branch) before any draw *)
    let drawn = Atomic.make 0 in
    let core =
      Composite
        { label = Labels.combine (Labels.one_of :: List.map label_of generators)
        ; generate_fn =
            (fun data ->
              let idx = Internal.generate_integer data ~min_value:0 ~max_value:(n - 1) in
              Atomic.set drawn idx;
              do_draw (core_of (List.nth generators idx)) data)
        }
    in
    Printable
      { core; sexp_of = (fun v -> (printer (List.nth generators (Atomic.get drawn))) v) }
[@@mode m = (nonportable, portable)]
;;

(** [optional_core element] is the generation structure behind {!optional}: a
    {!Labels.optional}-spanned draw that yields [None] or [Some] of [element]
    with equal probability. Shared with [Derive.generate_option] so derived
    option fields go through the same machinery. *)
let%template optional_core (element : 'a core MODE(m)) : 'a option core MODE(m) =
  Composite
    { label = Labels.combine [ Labels.optional; label_of_core element ]
    ; generate_fn =
        (fun data ->
          if Internal.generate_boolean data 0.5 None
          then Some (do_draw element data)
          else None)
    }
[@@mode m = (nonportable, portable)]
;;

(** [optional element] creates a generator that produces either [None] or
    [Some value] from [element].

    The [None]/[(Some v)] value renders through [Option.sexp_of_t] applied to
    [element]'s printer (the round-trippable form: [()] for [None], [(v)] for
    [Some v]). *)
let%template optional (element : ('a, printable) generator MODE(m))
  : ('a option, printable) generator MODE(m)
  =
  Printable
    { core = (optional_core [@mode m]) ((core_of [@mode m]) element)
    ; sexp_of = (fun v -> Sexplib0.Sexp_conv.sexp_of_option (printer element) v)
    }
[@@mode m = (nonportable, portable)]
;;

#ifdef OXCAML
(* The ipaddr library has no mode annotations. *)
let ipaddr_to_string = Obj.magic_portable Ipaddr.to_string
let ipaddr_v4_of_octets_exn = Obj.magic_portable Ipaddr.V4.of_octets_exn
let ipaddr_v6_of_octets_exn = Obj.magic_portable Ipaddr.V6.of_octets_exn
#else
let ipaddr_to_string = Ipaddr.to_string
let ipaddr_v4_of_octets_exn = Ipaddr.V4.of_octets_exn
let ipaddr_v6_of_octets_exn = Ipaddr.V6.of_octets_exn
#endif

(** [ip_addresses ?version ()] creates a generator for typed [Ipaddr.t] IP
    addresses.

    - [version = Some `V4]: generates IPv4 addresses (RFC 791).
    - [version = Some `V6]: generates IPv6 addresses (RFC 4291).
    - [version = None] (default): generates either version.

    The engine returns the address's raw network-order bytes, which [ipaddr]
    parses into a typed value; render with [Ipaddr.to_string] (RFC 5952
    canonical form for v6). *)
let ip_addresses ?version () : _ MODE(portable) =
  let sexp_of ip = Sexp.Atom (ipaddr_to_string ip) in
  let v4 tc = Ipaddr.V4 (ipaddr_v4_of_octets_exn (Internal.generate_ipv4 tc)) in
  let v6 tc = Ipaddr.V6 (ipaddr_v6_of_octets_exn (Internal.generate_ipv6 tc)) in
  let v4 = (leaf [@mode portable]) ~name:"ipv4" ~draw:v4 ~sexp_of
  and v6 = (leaf [@mode portable]) ~name:"ipv6" ~draw:v6 ~sexp_of in
  match version with
  | Some `V4 -> v4
  | Some `V6 -> v6
  | None -> (one_of [@mode portable]) [ v4; v6 ]
;;

(** [tuples2 g1 g2] creates a generator for 2-element tuples of printable
    components: each element is drawn in sequence inside a {!Labels.tuple} span. *)
let%template tuples2
      (type a b)
      (g1 : (a, printable) generator MODE(m))
      (g2 : (b, printable) generator MODE(m))
  : (a * b, printable) generator MODE(m)
  =
  let p1 = (printer [@mode m]) g1
  and p2 = (printer [@mode m]) g2 in
  let sexp_of (a, b) = Sexp.List [ p1 a; p2 b ] in
  let core =
    Composite
      { label = Labels.combine [ Labels.tuple; label_of g1; label_of g2 ]
      ; generate_fn =
          (fun data ->
            let a = do_draw (core_of g1) data in
            let b = do_draw (core_of g2) data in
            a, b)
      }
  in
  Printable { core; sexp_of }
[@@mode m = (nonportable, portable)]
;;

(** [tuples3 g1 g2 g3] creates a generator for 3-element tuples of printable
    components. *)
let%template tuples3
      (type a b c)
      (g1 : (a, printable) generator MODE(m))
      (g2 : (b, printable) generator MODE(m))
      (g3 : (c, printable) generator MODE(m))
  : (a * b * c, printable) generator MODE(m)
  =
  let p1 = (printer [@mode m]) g1
  and p2 = (printer [@mode m]) g2
  and p3 = (printer [@mode m]) g3 in
  let sexp_of (a, b, c) = Sexp.List [ p1 a; p2 b; p3 c ] in
  let core =
    Composite
      { label = Labels.combine [ Labels.tuple; label_of g1; label_of g2; label_of g3 ]
      ; generate_fn =
          (fun data ->
            let a = do_draw (core_of g1) data in
            let b = do_draw (core_of g2) data in
            let c = do_draw (core_of g3) data in
            a, b, c)
      }
  in
  Printable { core; sexp_of }
[@@mode m = (nonportable, portable)]
;;

(** [tuples4 g1 g2 g3 g4] creates a generator for 4-element tuples of printable
    components. *)
let%template tuples4
      (type a b c d)
      (g1 : (a, printable) generator MODE(m))
      (g2 : (b, printable) generator MODE(m))
      (g3 : (c, printable) generator MODE(m))
      (g4 : (d, printable) generator MODE(m))
  : (a * b * c * d, printable) generator MODE(m)
  =
  let p1 = (printer [@mode m]) g1
  and p2 = (printer [@mode m]) g2
  and p3 = (printer [@mode m]) g3
  and p4 = (printer [@mode m]) g4 in
  let sexp_of (a, b, c, d) = Sexp.List [ p1 a; p2 b; p3 c; p4 d ] in
  let core =
    Composite
      { label =
          Labels.combine
            [ Labels.tuple; label_of g1; label_of g2; label_of g3; label_of g4 ]
      ; generate_fn =
          (fun data ->
            let a = do_draw (core_of g1) data in
            let b = do_draw (core_of g2) data in
            let c = do_draw (core_of g3) data in
            let d = do_draw (core_of g4) data in
            a, b, c, d)
      }
  in
  Printable { core; sexp_of }
[@@mode m = (nonportable, portable)]
;;

type lark_compiled KIND(value mod portable contended) =
  { grammar : Internal.grammar
  ; markers : string list
  }

let lark_default_max_size = 8192
let lark_attempts = 3

let utf8_length s =
  String.fold_left (fun n c -> if Char.code c land 0xC0 = 0x80 then n else n + 1) 0 s
;;

let lark_import import_paths ~base_path path =
  List.find_map
    (fun dir ->
       let file = Filename.concat dir path in
       match In_channel.with_open_bin file In_channel.input_all with
       | text -> Some (file, text)
       | exception Sys_error _ -> None)
    (import_paths @ Option.to_list base_path)
;;

let lark_splice tc grammar terminals budget =
  let drawn = Internal.generate_grammar tc grammar ~max_size:budget in
  let len = String.length drawn in
  let matches_at i marker =
    i + String.length marker <= len && String.sub drawn i (String.length marker) = marker
  in
  let rec go pieces start i own count size =
    let flush stop =
      let piece = String.sub drawn start (stop - start) in
      piece :: pieces, own + utf8_length piece
    in
    if i >= len
    then (
      let pieces, own = flush len in
      String.concat "" (List.rev pieces), own, count, size + own)
    else (
      match
        if drawn.[i] = '<'
        then List.find_opt (fun (marker, _) -> matches_at i marker) terminals
        else None
      with
      | None -> go pieces start (i + 1) own count size
      | Some (marker, g) ->
        let pieces, own = flush i in
        let value = do_draw (core_of g) tc in
        let next = i + String.length marker in
        go (value :: pieces) next next own (count + 1) (size + utf8_length value))
  in
  go [] 0 0 0 0 0
;;

let%template from_lark
      grammar
      ?start
      ?(explicit : (string * (string, _) generator) list MODE(m) = [])
      ?(max_size = lark_default_max_size)
      ?max_depth
      ?(import_paths = [])
      ()
  : (string, printable) generator MODE(m)
  =
  if max_size < 1
  then raise (Internal.Usage_error (Printf.sprintf "max_size=%d must be at least 1" max_size));
  (match max_depth with
   | Some d when d < 1 ->
     raise (Internal.Usage_error (Printf.sprintf "max_depth=%d must be at least 1" d))
   | _ -> ());
  let names = List.map fst explicit in
  (match List.find_opt (fun n -> List.length (List.filter (String.equal n) names) > 1) names with
   | Some name ->
     raise
       (Internal.Usage_error
          (Printf.sprintf "explicit terminal '%s' is given more than one generator" name))
   | None -> ());
  let cache = Locked.create (fun () -> ref None) in
  let compile tc =
    Locked.protect cache (fun cell ->
      match !cell with
      | Some compiled -> compiled
      | None ->
        let grammar, markers =
          Internal.grammar_new
            tc
            ~text:grammar
            ~start
            ~max_size
            ~max_depth:(Option.value max_depth ~default:0)
            ~explicit:names
            ~import:(lark_import import_paths)
        in
        let compiled = { grammar; markers } in
        FINALISE (fun c -> Internal.grammar_free c.grammar) compiled;
        cell := Some compiled;
        compiled)
  in
  let draw tc =
    let compiled = compile tc in
    let value =
      match explicit with
      | [] -> Internal.generate_grammar tc compiled.grammar ~max_size:0
      | _ :: _ ->
        let terminals = List.map2 (fun marker (_, g) -> marker, g) compiled.markers explicit in
        let rec attempt k budget =
          if k = 0 then raise Internal.Assume_rejected;
          Internal.start_span ~label:Labels.lark_attempt tc;
          let out, own, count, size = lark_splice tc compiled.grammar terminals budget in
          if size <= max_size
          then (
            Internal.stop_span tc;
            out)
          else (
            Internal.stop_span ~discard:true tc;
            attempt
              (k - 1)
              (max 1 (min (max_size * (own + count) / size) (budget - 1))))
        in
        attempt lark_attempts max_size
    in
    ignore (Sys.opaque_identity compiled : lark_compiled);
    value
  in
  let label =
    Labels.combine
      (Labels.lark
       :: Labels.from_name grammar
       :: Labels.from_name (Option.value start ~default:"start")
       :: List.concat_map
            (fun (name, g) -> [ Labels.from_name name; label_of g ])
            explicit)
  in
  Printable { core = Leaf { draw; label }; sexp_of = Sexplib0.Sexp_conv.sexp_of_string }
[@@mode m = (nonportable, portable)]
;;
