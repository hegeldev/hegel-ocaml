;;

let settings_seed ctx s = function
  | Some seed -> check_rc ctx (c_settings_seed ctx s (Unsigned.UInt64.of_int seed) true)
  | None -> check_rc ctx (c_settings_seed ctx s Unsigned.UInt64.zero false)
;;

