; The optional Core companion library
; Core-typed generators and the sexp_diff-backed require_equal renderer.

(library
 (name hegel_jane)
 (public_name hegel.jane)
 (optional)
 (libraries hegel core sexp_diff)
 (preprocess
  (pps ppx_js_style hegel.template))
 (instrumentation
  (backend bisect_ppx)))

(rule
 (target hegel_jane.mli)
 (action
  (run
   %{bin:cppo}
   %{read-strings:../cppo-flags}
   -o
   %{target}
   %{dep:hegel_jane.mli.in})))
