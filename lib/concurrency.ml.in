type outcome = (exn * Printexc.raw_backtrace) option
#ifdef OXCAML
type 'ctx t =
  { spawn_join_n :
      n:int
      -> (f:('ctx @ local -> int -> outcome) @ portable -> outcome list @ contended) @ local
  }
#else
type 'ctx t = { spawn_join_n : n:int -> f:('ctx -> int -> outcome) -> outcome list }
#endif

(* we use an outcome list because arrays are contended in OxCaml *)

(* [guard f i] runs body [i]; an exception becomes its outcome. *)
let guard f i =
  try f () i with
  | exn -> Some (exn, Printexc.get_raw_backtrace ())
;;

let threads =
  { spawn_join_n =
      (fun ~n ~f ->
        let outcomes = Array.make n None in
        let run i = outcomes.(i) <- guard f i in
        let workers = List.init n (fun i -> Thread.create run i) in
        List.iter Thread.join workers;
        Array.to_list outcomes)
  }
;;

#ifndef OXCAML
(* Each domain has its own job queue. Jobs are handed to queues round-robin
   and each one runs on its own systhread inside its domain. The pool lasts
   for the lifetime of the process. *)
module Domain_pool = struct
  type worker =
    { lock : Mutex.t
    ; ready : Condition.t
    ; jobs : (unit -> unit) Queue.t
    ; mutable stop : bool
    }

  let rec run w =
    let next =
      Mutex.protect w.lock (fun () ->
        while Queue.is_empty w.jobs && not w.stop do
          Condition.wait w.ready w.lock
        done;
        if w.stop then None else Some (Queue.pop w.jobs))
    in
    match next with
    | None -> ()
    | Some job ->
      ignore (Thread.create job () : Thread.t);
      run w
  ;;

  let workers = ref [||]
  let domains = ref []
  let next = Atomic.make 0
  let pool_lock = Mutex.create ()

  let () =
    at_exit (fun () ->
      Array.iter
        (fun w ->
           Mutex.protect w.lock (fun () ->
             w.stop <- true;
             Condition.signal w.ready))
        !workers;
      List.iter Domain.join !domains)
  ;;

  (* Grows the pool to [min n cap] domains and returns its workers. *)
  let workers_for n =
    Mutex.protect pool_lock (fun () ->
      (* minus 1 because runner's domain takes 1 *)
      let cap = Domain.recommended_domain_count () - 1 in
      for _ = Array.length !workers + 1 to max 1 (min n cap) do
        let w =
          { lock = Mutex.create () (* lock on worker itself *)
          ; ready = Condition.create () (* worker has everything it needs to execute *)
          ; jobs = Queue.create ()
          ; stop = false (* test is about to end *)
          }
        in
        (* record each worker with its domain, so a failed spawn cannot leave
           a domain that joins but never stops *)
        domains := Domain.spawn (fun () -> run w) :: !domains;
        workers := Array.append !workers [| w |]
      done;
      !workers)
  ;;

  let submit workers job =
    let w = workers.(Atomic.fetch_and_add next 1 mod Array.length workers) in
    Mutex.protect w.lock (fun () ->
      Queue.push job w.jobs;
      Condition.signal w.ready)
  ;;

  let spawn_join_n ~n ~f =
    let workers = workers_for n in
    let outcomes = Array.make n None in
    let lock = Mutex.create () in
    let finished = Condition.create () in
    let remaining = ref n in
    for i = 0 to n - 1 do
      submit workers (fun () ->
        outcomes.(i) <- guard f i;
        Mutex.protect lock (fun () ->
          decr remaining;
          if !remaining = 0 then Condition.signal finished))
    done;
    Mutex.protect lock (fun () ->
      while !remaining > 0 do
        Condition.wait finished lock
      done);
    Array.to_list outcomes
  ;;
end

let domains = { spawn_join_n = Domain_pool.spawn_join_n }
#endif
