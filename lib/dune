(library
 (name hegel)
 (public_name hegel)
 (libraries hegel_ffi ipaddr sexplib0 threads.posix unix yojson)
 (private_modules
  generators_core
  generators_primitives
  generators_collections
  generators_combinators
  generators_functions)
 (preprocess
  (pps ppx_js_style))
 (instrumentation
  (backend bisect_ppx)))

; Only compiler-flavor detection needs a shell. Run cppo directly before PPX.

(rule
 (target cppo-flags)
 (action
  (with-stdout-to
   %{target}
   (bash
    "case '%{ocaml_version}' in *+ox*) echo '-D';; *) echo '-U';; esac; echo OXCAML"))))

(rule
 (target generators.mli)
 (action
  (run
   %{bin:cppo}
   %{read-strings:cppo-flags}
   -o
   %{target}
   %{dep:generators.mli.in})))

(rule
 (target hegel.mli)
 (action
  (run
   %{bin:cppo}
   %{read-strings:cppo-flags}
   -o
   %{target}
   %{dep:hegel.mli.in})))

(rule
 (target generators.ml)
 (action
  (run
   %{bin:cppo}
   %{read-strings:cppo-flags}
   -o
   %{target}
   %{dep:generators.ml.in})))

(rule
 (target internal.ml)
 (action
  (run
   %{bin:cppo}
   %{read-strings:cppo-flags}
   -o
   %{target}
   %{dep:internal.ml.in})))
