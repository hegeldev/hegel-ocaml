(library
 (name hegel)
 (public_name hegel)
 (libraries hegel_ffi ipaddr sexplib0 threads.posix unix yojson)
 (private_modules
  draw_compat
  generators_core
  generators_primitives
  generators_collections
  generators_combinators
  generators_functions)
 (preprocess
  (pps ppx_js_style))
 (instrumentation
  (backend bisect_ppx)))

; Keep the public interfaces in one place. Only OxCaml understands call_pos;
; ordinary OCaml retains explicit optional source positions.

(rule
 (targets generators.mli hegel.mli)
 (deps generators.mli.in hegel.mli.in)
 (action
  (bash
   "case '%{ocaml_version}' in *+ox*) for name in generators hegel; do sed 's/?loc:Lexing.position/loc:[%call_pos]/g' $name.mli.in > $name.mli; done;; *) for name in generators hegel; do cp $name.mli.in $name.mli; done;; esac")))

(rule
 (target draw_compat.ml)
 (deps draw_compat_ocaml.ml.inc draw_compat_oxcaml.ml.inc)
 (action
  (with-stdout-to
   %{target}
   (bash
    "case '%{ocaml_version}' in *+ox*) cat %{dep:draw_compat_oxcaml.ml.inc};; *) cat %{dep:draw_compat_ocaml.ml.inc};; esac"))))
