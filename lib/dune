(library
 (name hegel)
 (public_name hegel)
 (libraries
  hegel_ffi
  ipaddr
  sexplib0
  threads.posix
  unix
  ; Locked: mutex-guarded shared data. Under OxCaml (where capsule0 is
  ; installable) it is a capsule, so portable code can use it; elsewhere a
  ; Mutex around the value. Neither variant depends on core.
  (select
   locked.ml
   from
   (capsule0.prim capsule0.blocking_sync -> locked.capsule.ml)
   (-> locked.mutex.ml)))
 (private_modules
  io
  locked
  generators_core
  generators_primitives
  generators_collections
  generators_combinators
  generators_functions)
 (preprocess
  (pps ppx_js_style hegel.template))
 (instrumentation
  (backend bisect_ppx)))

; Only compiler-flavor detection needs a shell. Run cppo directly before PPX.

(rule
 (target cppo-flags)
 (action
  (with-stdout-to
   %{target}
   (bash
    "case '%{ocaml_version}' in *+ox*) echo '-D';; *) echo '-U';; esac; echo OXCAML"))))

(rule
 (target generators.mli)
 (action
  (run
   %{bin:cppo}
   %{read-strings:cppo-flags}
   -o
   %{target}
   %{dep:generators.mli.in})))

(rule
 (target hegel.mli)
 (action
  (run
   %{bin:cppo}
   %{read-strings:cppo-flags}
   -o
   %{target}
   %{dep:hegel.mli.in})))

