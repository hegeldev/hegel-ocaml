(** Stateful property-based testing for Hegel. See [stateful.mli]. *)

#ifdef OXCAML
#define CONCURRENCY_ARG (concurrency : Concurrency.t @ local = Concurrency.threads)
#define LOCAL_CONCURRENCY (concurrency : Concurrency.t @ local)
#else
#define CONCURRENCY_ARG (concurrency = Concurrency.threads)
#define LOCAL_CONCURRENCY (concurrency : Concurrency.t)
#endif

module Pool_gen = Generators.Int_pool

module Pool = struct
#ifdef OXCAML
  type ('a : value mod portable contended) t : value mod portable contended = 'a Pool_gen.t
#else
  type 'a t = 'a Pool_gen.t
#endif

  let create ?(clone = Fun.id) tc = Pool_gen.create tc ~clone
  let add = Pool_gen.add
  let is_empty = Pool_gen.is_empty
  let size = Pool_gen.size
  let values_reusable t = Pool_gen.pool_values t ~consume:false
  let values_consumed t = Pool_gen.pool_values t ~consume:true
end

module Rule = struct
#ifdef OXCAML
  type 'state t : value mod portable contended =
    { name : string
    ; group : string
    ; step : (Internal.test_case -> 'state @ contended -> unit) @@ portable
    }
#else
  type 'state t =
    { name : string
    ; group : string
    ; step : Internal.test_case -> 'state -> unit
    }
#endif

  let create ?(group = "<anonymous>") ~name ~step () = { name; group; step }
  let name t = t.name
  let group t = t.group
end

module Invariant = struct
  type 'state t =
    { name : string
    ; inv : Internal.test_case -> 'state -> unit
    ; always_check : bool
    }

  let create ~name ~inv ?(always_check = false) () = { name; inv; always_check }
  let name invariant = invariant.name
end

let check_invariants tc ~state_machine ~invariants ~where ~sample state =
  Array.iteri
    (fun i invariant ->
       if
         (not sample)
         || Internal.state_machine_should_check_invariant
              tc
              ~state_machine
              ~invariant_index:i
       then (
         match
           if Internal.should_print tc
           then
             Internal.with_block tc ~indent:2 (fun tc -> invariant.Invariant.inv tc state)
           else invariant.Invariant.inv tc state
         with
         | () -> ()
         | exception e ->
           Internal.note
             tc
             (Printf.sprintf "Invariant %s violated %s." (Invariant.name invariant) where);
           raise e))
    invariants
;;

let print_state_of tc sexp_of_state state =
  Option.iter
    (fun sexp_of -> Internal.print_line tc [ Text "state = "; Value (sexp_of state) ])
    sexp_of_state
;;

let unique_groups groups =
  Array.fold_left
    (fun names group -> if List.mem group names then names else group :: names)
    []
    groups
  |> List.rev
  |> Array.of_list
;;

let group_indices groups names =
  Array.map
    (fun group -> Array.find_index (String.equal group) names |> Option.get)
    groups
;;

let dispatch_round LOCAL_CONCURRENCY tc ~num_workers ~work =
  let cases =
    List.init num_workers (fun worker_index ->
      let worker_tc = Internal.clone tc in
      Internal.set_worker_index worker_tc worker_index;
      worker_tc)
  in
  concurrency.spawn_join_n ~n:num_workers ~f:(fun worker_index ->
    match work ~worker_index (List.nth cases worker_index) with
    | (_ : bool) -> None
    | exception exn -> Some (exn, Printexc.get_raw_backtrace ()))
;;

let reraise_worker_failure (outcomes : Concurrency.outcome list) =
  let find predicate =
    List.find_map
      (function
        | Some (exn, _) as failure when predicate exn -> failure
        | _ -> None)
      outcomes
  in
  let is_control_exception = function
    | Internal.Usage_error _ | Internal.Internal_error _ -> true
    | _ -> false
  in
  let is_overrun = function
    | Internal.Stop_test -> true
    | _ -> false
  in
  let is_invalid = function
    | Internal.Assume_rejected | Internal.Flaky_strategy -> true
    | _ -> false
  in
  let is_test_failure = Fun.const true in
  (* invalidated or exhausted rules can cause exceptions in other workers.
     exception precedence from greatest to least: usage/internal errors, overrun,
     invalidation, actual test failure. within each category, first worker raises. *)
  let failure =
    Array.find_map
      find
      [| is_control_exception; is_overrun; is_invalid; is_test_failure |]
  in
  Option.iter
    (fun (exn, backtrace) -> Printexc.raise_with_backtrace exn backtrace)
    failure
;;

let run_rounds
      LOCAL_CONCURRENCY
      tc
      ~state_machine
      ~num_workers
      ~work
      ~group_names
      ~steps_attempted
      ~print_state
      ~check_invariants
  =
  let seq_step () =
    Internal.start_span ~label:Generators.Private.Labels.stateful_rule tc;
    match Internal.state_machine_next_group tc ~state_machine with
    | None ->
      Internal.stop_span tc;
      false
    | Some _ ->
      let rejected =
        match work ~worker_index:0 tc with
        | rejected -> rejected
        | exception e ->
          Internal.stop_span tc;
          raise e
      in
      Internal.stop_span ~discard:rejected tc;
      true
  in
  let concurrent_round concurrency round =
    match Internal.state_machine_next_group tc ~state_machine with
    | None -> false
    | Some group ->
      Internal.note
        tc
        (Printf.sprintf
           "---------------- Round %d: group %S ----------------"
           round
           group_names.(group));
      reraise_worker_failure (dispatch_round concurrency tc ~num_workers ~work);
      true
  in
  (* [concurrency] is passed down rather than captured, so it may be local. *)
  let rec loop concurrency round =
    let ran =
      if num_workers = 1 then seq_step () else concurrent_round concurrency round
    in
    if ran
    then (
      print_state ();
      let where =
        if num_workers = 1
        then Printf.sprintf "after step %d" (Atomic.get steps_attempted)
        else Printf.sprintf "after round %d" round
      in
      check_invariants ~where ~sample:true;
      loop concurrency (round + 1))
  in
  loop concurrency 1
;;

let run_internal
      ~init
      ~rules
      ~invariants
      ?CONCURRENCY_ARG
      ?(min_concurrency = 1)
      ?(max_concurrency = min_concurrency)
      ?sexp_of_state
      ?(step_count = 50)
      tc
  =
  let rule_array = Array.of_list rules in
  let rule_groups = Array.map Rule.group rule_array in
  let group_names = unique_groups rule_groups in
  let invariants = Array.of_list invariants in
  let state_machine, num_workers =
    Internal.new_state_machine_with_concurrency
      tc
      ~rule_names:(Array.map Rule.name rule_array)
      ~rule_groups:(group_indices rule_groups group_names)
      ~invariant_names:(Array.map Invariant.name invariants)
      ~invariants_always_check:
        (Array.map (fun inv -> inv.Invariant.always_check) invariants)
      ~step_count
      ~min_concurrency
      ~max_concurrency
  in
  let print_state () = print_state_of tc sexp_of_state init in
  let check_invariants ~where ~sample =
    check_invariants tc ~state_machine ~invariants ~where ~sample init
  in
  let announce_checks which =
    if Array.length invariants > 0
    then Internal.note tc (Printf.sprintf "Checking invariants on the %s state." which)
  in
  let steps_attempted = Atomic.make 0 in
  let work ~worker_index tc =
    let rec loop rejected =
      match
        Internal.state_machine_next_rule_for_worker tc ~state_machine ~worker_index
      with
      | None -> rejected
      | Some rule_index ->
        let rule = List.nth rules rule_index in
        let step = Atomic.fetch_and_add steps_attempted 1 + 1 in
        Internal.note
          tc
          (if num_workers = 1
           then Printf.sprintf "Step %d: %s" step rule.Rule.name
           else Printf.sprintf "Rule: %s" rule.Rule.name);
        (match
           if Internal.should_print tc
           then Internal.with_block tc ~indent:2 (fun tc -> rule.Rule.step tc init)
           else rule.Rule.step tc init
         with
         | () -> loop rejected
         | exception Internal.Assume_rejected ->
           Internal.state_machine_rule_rejected_for_worker tc ~state_machine ~worker_index;
           Internal.note tc "Rule stopped early due to violated assumption.";
           loop true)
    in
    loop false
  in
  let free () = Internal.state_machine_free tc ~state_machine in
  let run_test () =
    if num_workers > 1
    then Internal.note tc (Printf.sprintf "Concurrency level: %d" num_workers);
    print_state ();
    announce_checks "initial";
    check_invariants ~where:"in the initial state" ~sample:false;
    run_rounds
      concurrency
      tc
      ~state_machine
      ~num_workers
      ~work
      ~group_names
      ~steps_attempted
      ~print_state
      ~check_invariants;
    announce_checks "final";
    check_invariants ~where:"in the final state" ~sample:false
  in
  match run_test () with
  | () -> free ()
  | exception exn ->
    free ();
    raise exn
;;

module type State_machine = sig
  type state

  val rules : state Rule.t list
  val invariants : state Invariant.t list
end

let run
      (type s)
      ?concurrency
      ?min_concurrency
      ?max_concurrency
      ?step_count
      ?sexp_of_state
      tc
      (module M : State_machine with type state = s)
      ~(init : s)
  =
  run_internal
    ~init
    ~rules:M.rules
    ~invariants:M.invariants
    ?concurrency
    ?min_concurrency
    ?max_concurrency
    ?sexp_of_state
    ?step_count
    tc
;;
